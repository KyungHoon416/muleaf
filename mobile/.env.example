VITE_PUBLIC_SITE_URL=https://muleaf-ed246.web.app
# Set an HTTPS API endpoint that accepts the native origins and stores reports.
# Do not point this to the current same-origin-only Cloudflare reports API.
VITE_REPORTS_API_URL=
# Enable after deploying the own OAuth server and provider credentials.
VITE_AUTH_ENABLED=false
# Empty for same-origin reverse proxy. Otherwise use a same-site HTTPS custom domain.
VITE_AUTH_SERVER_ORIGIN=
